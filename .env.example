# MediKiosk (SIH26047 - Ministry of Ayush)
# Environment Configuration Template
# NOTE: MediKiosk is demo-ready out of the box without any keys.
# In production, wire up these environment variables to connect real government endpoints.

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# 1. Bhashini Multilingual ASR & TTS APIs (Ministry of Electronics & IT)
# https://bhashini.gov.in/
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_inference_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

# 2. Ayushman Bharat Digital Mission (ABDM Sandbox Gateway)
# https://sandbox.abdm.gov.in/
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_FACILITY_ID=IN0710001004

# 3. Medical OCR & Document Processing (LayoutLM / AWS Textract / Cloud Vision)
OCR_API_ENDPOINT=https://api.medikiosk.internal/v1/ocr/extract
OCR_API_KEY=your_medical_ocr_api_key

# 4. Ayush Grid / AHMIS Integration
AYUSH_GRID_ENDPOINT=https://ahmis.ayush.gov.in/api/v1/casesheets
AYUSH_NAMASTE_PORTAL_KEY=your_namaste_ontology_key
